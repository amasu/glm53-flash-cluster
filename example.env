# GLM-5.3-Flash cluster — configuration template
# Copy to .env and fill in your cluster's values. Keep .env out of git.
#
# .env is used in THREE places:
#   1. next to cluster.sh on the orchestrator (this directory)
#   2. at REMOTE_DIR on the head node      (docker compose --env-file .env)
#   3. at REMOTE_DIR on the worker node    (docker compose --env-file .env)

# --- Hosts -------------------------------------------------------------
# ssh-reachable address of the head node (orchestrator -> head)
HEAD_HOST=head.example.com
# head node IP on the high-speed fabric (rank 0 rendezvous / NCCL / VLLM_HOST_IP)
HEAD_IP=
# worker node address, as reached FROM the head node
# (two-hop ssh for orchestration; also the fabric IP for rank 1)
WORKER_IP=

# --- Paths (must be identical on BOTH nodes) ---------------------------
# where this repo lives on the cluster nodes
REMOTE_DIR=/home/user/glm53-flash-cluster
# where model weights are staged on both nodes
WEIGHTS_DIR=/var/tmp/glm-5.3-flash-nvfp4
# vLLM/HF cache dir on both nodes
VLLM_CACHE_DIR=/var/tmp/glm53-vllm-cache

# --- Serving -----------------------------------------------------------
SERVING_PORT=8000
MASTER_PORT=29521
IMAGE=glm53:v9

# --- Fabric / NCCL (site-specific) -------------------------------------
# subnet of the interconnect fabric, e.g. 10.0.0.0/24
FABRIC_RANGE=
# fabric interface name on both nodes (`ip link`), e.g. enp1s0f1np1
IF_NAME=
# RoCE/IB HCA list (`ibdev2netdev`), e.g. rocep1s0f1,roceP2p1s0f1
NCCL_IB_HCA=
NCCL_IB_GID_INDEX=3
