# GLM-5.3-Flash cluster — configuration template
# Copy to .env and fill in your cluster's values. Keep .env out of git.
#
# .env is used in THREE places:
#   1. next to cluster.sh on the orchestrator (this directory)
#   2. at REMOTE_DIR on the head node      (docker compose --env-file .env)
#   3. at REMOTE_DIR on the worker node    (docker compose --env-file .env)

# --- Hosts -------------------------------------------------------------
# ssh-reachable address of the head node (orchestrator -> head)
HEAD_HOST=head.example.com
# head node IP on the high-speed fabric (rank 0 rendezvous / NCCL / VLLM_HOST_IP)
HEAD_IP=
# worker node address, as reached FROM the head node
# (two-hop ssh for orchestration; also the fabric IP for rank 1)
WORKER_IP=

# --- Paths (must be identical on BOTH nodes) ---------------------------
# where this repo lives on the cluster nodes
REMOTE_DIR=/home/user/glm53-flash-cluster
# where model weights are staged on both nodes
WEIGHTS_DIR=/var/tmp/glm-5.3-flash-nvfp4
# vLLM/HF cache dir on both nodes
VLLM_CACHE_DIR=/var/tmp/glm53-vllm-cache

# --- Serving -----------------------------------------------------------
SERVING_PORT=8000
MASTER_PORT=29521
IMAGE=glm53:v9

# --- Fabric / NCCL (site-specific) -------------------------------------
# subnet of the interconnect fabric, e.g. 10.0.0.0/24
FABRIC_RANGE=
# fabric interface name on both nodes (`ip link`), e.g. enp1s0f1np1
IF_NAME=
# RoCE/IB HCA list (`ibdev2netdev`), e.g. rocep1s0f1,roceP2p1s0f1
NCCL_IB_HCA=
NCCL_IB_GID_INDEX=3

# --- Lab-quant stack (lab/, the standing config) ------------------------
# Uses HEAD_HOST/WORKER_IP/HEAD_IP/FABRIC_RANGE/IF_NAME/NCCL_IB_HCA/SERVING_PORT
# from above. Lab-specific:
# path to the lab-quant weights (both nodes)
WEIGHTS_DIR_LAB=/var/tmp/glm-5.3-flash-lab-nvfp4
# lab image tag (built from lab/build/, see docker/lab-build.sh)
LAB_IMAGE=glm53:lab
# which lab stack is current: lab (LMO standing config) or lab-vision
# (vision ON, 0rand #130 profile) — lab-launch.sh/watchdog select on this
LAB_STACK=lab
# lab rendezvous port (29500 matches the kilork/0rand recipe)
MASTER_PORT_LAB=29500
# proven standing values — do not raise MAX_NUM_BATCHED_TOKENS past 1024 on
# GB10 (the gist's 4096 OOM-kills the head worker; see lab/build/README.md)
LAB_KV_CACHE_BYTES=10737418240
# lab-vision profile's KV pin (9 GiB — activation headroom for the mm
# front-end + warmup on GB10; 10 GiB OOMs the warmup forward, 2026-08-31)
LAB_VISION_KV_CACHE_BYTES=9448928000
LAB_MAX_NUM_SEQS=16
LAB_MAX_NUM_BATCHED_TOKENS=1024
LAB_MTP_K=3
