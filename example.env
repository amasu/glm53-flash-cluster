# GLM-5.3-Flash cluster — configuration template
# Copy to .env and fill in your cluster's values. Keep .env out of git.
#
# .env is used in THREE places:
#   1. next to cluster.sh on the orchestrator (this directory)
#   2. at REMOTE_DIR on the head node      (docker compose env, sourced by the node)
#   3. at REMOTE_DIR on the worker node    (same)
#
# Stack selection: one .env serves every stack. The stack's own knobs
# (image, weights dir, rendezvous port, KV pin, ctx, MTP, mm flags) live in
# stacks/<STACK>.env — NOT here. This file only carries site values.

# --- Stack selection ---------------------------------------------------------
# default stack when running `cluster.sh up` without a stack argument
# (lab | lab-vision | v9-512k | v9-262k-fp8 | v8-262k)
# the running production profile is lab-vision (lab-quant + vision ON)
STACK=lab-vision

# --- Hosts -------------------------------------------------------------
# ssh-reachable address of the head node (orchestrator -> head)
HEAD_HOST=head.example.com
# head node IP on the high-speed fabric (rank 0 rendezvous / NCCL / VLLM_HOST_IP)
HEAD_IP=
# worker node address, as reached FROM the head node
# (two-hop ssh for orchestration; also the fabric IP for rank 1)
WORKER_IP=

# --- Paths (must be identical on BOTH nodes) ---------------------------
# where this repo lives on the cluster nodes
REMOTE_DIR=/home/user/glm53-flash-cluster
# vLLM/HF cache dir on both nodes
VLLM_CACHE_DIR=/var/tmp/glm53-vllm-cache

# --- Serving -----------------------------------------------------------
SERVING_PORT=8000

# --- Fabric / NCCL (site-specific) -------------------------------------
# subnet of the interconnect fabric, e.g. 10.0.0.0/24
FABRIC_RANGE=
# fabric interface name on both nodes (`ip link`), e.g. enp1s0f1np1
IF_NAME=
# RoCE/IB HCA list (`ibdev2netdev`), e.g. rocep1s0f1,roceP2p1s0f1
NCCL_IB_HCA=
NCCL_IB_GID_INDEX=3

# --- Stack-owned paths & defaults (consumed by stacks/*.env) ------------
# LibertAIDAI uniform-NVFP4 weights (used by the v9-512k / v9-262k-fp8 /
# v8-262k stacks; fetched by fetch-weights.sh)
WEIGHTS_DIR=/var/tmp/glm-5.3-flash-nvfp4
# lab-quant weights (local-inference-lab/GLM-5.3-Flash-NVFP4 @ 378ca545…,
# used by the lab / lab-vision stacks)
WEIGHTS_DIR_LAB=/var/tmp/glm-5.3-flash-lab-nvfp4
# NVIDIA official NVFP4 weights (nvidia/GLM-5.3-Flash-NVFP4 @ 09b04e5e…,
# used by the nvfp4-dflash2 stack; fetched by `fetch-weights.sh nvidia-nvfp4`)
WEIGHTS_DIR_NVFP4=/var/tmp/glm-5.3-flash-nvidia-nvfp4
# DFlash2 draft staging ROOT (contains $DRAFT_NAME; must be identical on
# BOTH nodes; mounted at /workspace/models by the nvfp4-dflash2 stack;
# fetched by `fetch-weights.sh nvidia-nvfp4`)
DRAFT_DIR=/var/tmp/glm53-dflash2
# image tags — the stack files default to these, override here to retag
IMAGE=glm53:v9
LAB_IMAGE=glm53:lab
# pilcothink 0.28 runtime (nvfp4-dflash2 stack; ships the b12x backends)
NVFP4_IMAGE=pilcothink/vllm_spark_glm53:0.28
# rendezvous ports — the stack files default to these
MASTER_PORT=29521
MASTER_PORT_LAB=29500
MASTER_PORT_NVFP4=29503
