# stacks/lab-vision.env — lab-quant, VISION ENABLED (glm53:lab, same image
# and weights as lab.env). 0rand proven mm config (forum #381350 #127/#130):
# --skip-mm-profiling (vision tower ~60K KV tokens instead of ~300K) +
# modern-format --limit-mm-per-prompt. KV pin 9 GiB: 10 GiB OOMs the warmup
# forward with the mm front-end on the GB10 UMA line (benchmarks.md §9).
# A/B same-harness: 92.5 vs 89.5 LMO — no text-quality cost. 2026-08-31.
#
# Same single-stack policy as every stack: only ONE profile runs at a time;
# switching = down both, then up with STACK=lab-vision.

STACK_NAME=lab-vision
IMAGE="${LAB_IMAGE:-glm53:lab}"
WEIGHTS_DIR="${WEIGHTS_DIR_LAB:?WEIGHTS_DIR_LAB must be set in .env}"
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-/var/tmp/glm53-vllm-cache}"
MASTER_PORT="${MASTER_PORT_LAB:-29500}"

# --- serving knobs (identical to lab.env except KV pin + mm flags) ---------
SERVED_MODEL_NAME=glm-5.3-flash
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_ds_mla
KV_CACHE_MEMORY_BYTES=9448928000      # 9 GiB — mm front-end activation headroom
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=16
BLOCK_SIZE=256
MAX_NUM_BATCHED_TOKENS=1024
MOE_BACKEND=
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
# NO --language-model-only here: the multimodal front-end stays ON
SWITCHES='--enable-chunked-prefill --enable-prefix-caching --disable-custom-all-reduce --enforce-eager --skip-mm-profiling'
KERNEL_CONFIG='{"enable_cutedsl_warmup":false,"enable_flashinfer_autotune":false}'
# modern dict format only — the legacy {"video": 1} form is REJECTED by this
# vLLM build (0rand post #130)
LIMIT_MM_PER_PROMPT='{"image": 4, "video": {"count": 1, "num_frames": 32, "width": 512, "height": 512}}'

VLLM_MLA_NOPE_PAD_ROPE=1
TORCH_USE_RTLD_GLOBAL=1
VLLM_USE_AOT_COMPILE=0
OMP_NUM_THREADS=4
FLASHINFER_DISABLE_VERSION_CHECK=
