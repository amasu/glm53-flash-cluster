# stacks/lab.env — lab-quant standing config (glm53:lab).
# Source: kilork gist a887667f4f423b7cc324859cd5e32ebd (92/100 tool-eval
# hardmode, seed 42) + 0rand post-#124 sizing (1024/16). Quality 90/100 on
# this cluster (benchmarks.md §6–§9). This is the single-stack standing
# profile — STACK=lab is the stackctl.sh default.
#
# This file must stay PURE CONFIG: no site values (hosts, fabric) — those
# live in .env, shared by every stack. Only knobs and stack-owned paths.

STACK_NAME=lab
IMAGE="${LAB_IMAGE:-glm53:lab}"
# lab-quant weights (local-inference-lab/GLM-5.3-Flash-NVFP4 @ 378ca545…)
WEIGHTS_DIR="${WEIGHTS_DIR_LAB:?WEIGHTS_DIR_LAB must be set in .env}"
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-/var/tmp/glm53-vllm-cache}"
# rendezvous (29500 matches the kilork/0rand recipe)
MASTER_PORT="${MASTER_PORT_LAB:-29500}"

# --- serving knobs (proven; see benchmarks.md before changing) -------------
SERVED_MODEL_NAME=glm-5.3-flash
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_ds_mla
KV_CACHE_MEMORY_BYTES=10737418240     # 10 GiB pin -> 1,164,369-token pool
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=16
BLOCK_SIZE=256
# do not raise 1024 past on GB10 — 4096 OOM-kills the head worker on the
# first parallel-4 forward (repro'd 2x on 08-30; see lab recipe README)
MAX_NUM_BATCHED_TOKENS=1024
MOE_BACKEND=
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
SWITCHES='--enable-chunked-prefill --enable-prefix-caching --disable-custom-all-reduce --enforce-eager --language-model-only'
KERNEL_CONFIG='{"enable_cutedsl_warmup":false,"enable_flashinfer_autotune":false}'
# mm front-end OFF (text-only) via --language-model-only above; nothing else
LIMIT_MM_PER_PROMPT=

# --- image-specific runtime flags (baked into glm53:lab) -------------------
VLLM_MLA_NOPE_PAD_ROPE=1              # NoPE-MLA rope-pad mod (fp8_ds_mla KV)
TORCH_USE_RTLD_GLOBAL=1
VLLM_USE_AOT_COMPILE=0
OMP_NUM_THREADS=4
FLASHINFER_DISABLE_VERSION_CHECK=
