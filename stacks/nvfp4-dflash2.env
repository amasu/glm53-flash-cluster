# stacks/nvfp4-dflash2.env — NVIDIA official NVFP4 quant on the pilcothink 0.28
# runtime image, DFlash2 k=5 speculative draft, 900K context. Byte-identical
# recipe to 0rand/glm-5.3-flash-nvidia-nvfp4-dflash-2x-dgx-sparks (launch-
# verified 900K profile, 2026-09-16; boot ~980 s, KV pool 1,080,115 tokens =
# 1.20x at full context, 32.0 t/s pp1024/tg1024 c1 warm).
#
# Differences vs the in-repo stacks (all of them):
#   - different image (pilcothink 0.28, ships the b12x MoE/linear backends)
#   - different weights (nvidia/GLM-5.3-Flash-NVFP4 @ 09b04e5e…, staged flat
#     at WEIGHTS_DIR_NVFP4 by fetch-weights.sh nvidia-nvfp4)
#   - a MANDATORY separate draft model (the official NVFP4 checkpoint ships
#     zero MTP/nextn tensors, so MTP speculation is impossible; DFlash2 is
#     required). Staged at DRAFT_DIR/$DRAFT_NAME, mounted at /workspace/models.
#   - NO --enforce-eager (cudagraphs <=16 + async scheduling ON instead),
#   - VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0 (the graph-mode memory
#     estimator otherwise reserves ~2.1 GiB of KV),
#   - VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (900K > the engine's soft cap).
#
# Same single-stack policy as every stack: only ONE profile runs at a time;
# switching = down both, then up with STACK=nvfp4-dflash2.

STACK_NAME=nvfp4-dflash2
IMAGE="${NVFP4_IMAGE:-pilcothink/vllm_spark_glm53:0.28}"
# NVIDIA official NVFP4 weights (staged flat; fetch-weights.sh nvidia-nvfp4)
WEIGHTS_DIR="${WEIGHTS_DIR_NVFP4:?WEIGHTS_DIR_NVFP4 must be set in .env}"
# DFlash2 draft root (mounted at /workspace/models inside both containers)
DRAFT_DIR="${DRAFT_DIR:?DRAFT_DIR must be set in .env}"
DRAFT_NAME=glm53-dflash2-orig
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-/var/tmp/glm53-vllm-cache}"
# rendezvous port — recipe value, distinct from the v9/lab stacks
MASTER_PORT="${MASTER_PORT_NVFP4:-29503}"

# --- serving knobs (the 900K profile; see the 0rand repo docs/FINDINGS.md) --
SERVED_MODEL_NAME=glm-5.3-flash
# 0.88, not 0.90: this image's admission check rejected 0.885 by 0.41 GiB
# with host services online (documented in the 0rand README).
GPU_MEMORY_UTILIZATION=0.88
KV_CACHE_DTYPE=fp8
KV_CACHE_MEMORY_BYTES=9663676416      # 9 GiB pin -> 1,080,115-token pool
MAX_MODEL_LEN=900096                  # 3,516 x 256
MAX_NUM_SEQS=4
BLOCK_SIZE=256
MAX_NUM_BATCHED_TOKENS=1024
# recipe: uniform-NVFP4 target at bfloat16 activations
DTYPE=bfloat16
MOE_BACKEND=b12x
LINEAR_BACKEND=b12x
MAMBA_CACHE_MODE=align
# a KV-budget lever, not just a perf knob (small capture => big estimate)
MAX_CUDAGRAPH_CAPTURE_SIZE=16
# MTP is impossible on this checkpoint (no MTP heads) — DFlash2 k=5 instead.
# Path is the in-container mount, byte-identical to the recipe.
SPECULATIVE_CONFIG='{"method":"dflash","model":"/workspace/models/glm53-dflash2-orig","num_speculative_tokens":5,"attention_backend":"TRITON_ATTN","kv_cache_dtype":"auto","draft_sample_method":"probabilistic","rejection_sample_method":"standard","enable_adaptive_verification":false,"disable_eagle_block_drop":false}'
# graphs ON (no --enforce-eager), async scheduling, autotune off (recipe)
SWITCHES='--enable-chunked-prefill --enable-prefix-caching --async-scheduling --skip-mm-profiling --no-enable-flashinfer-autotune'
KERNEL_CONFIG=
LIMIT_MM_PER_PROMPT=

# --- recipe env (image-specific runtime; empty on the other stacks) ---------
# graph-mode CUDA-memory estimator off: returns ~2.1 GiB of KV to the pool
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
# 900K context exceeds the engine's soft max-model-len cap
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
# runtime's target-block-size split heuristic (0rand launcher sets it too)
VLLM_GLM53_SPLIT_TARGET_BLOCK_SIZE=auto
TORCH_USE_RTLD_GLOBAL=1
TORCHINDUCTOR_COMPILE_THREADS=1
OMP_NUM_THREADS=4
VLLM_MLA_NOPE_PAD_ROPE=
VLLM_USE_AOT_COMPILE=
FLASHINFER_DISABLE_VERSION_CHECK=
