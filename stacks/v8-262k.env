# stacks/v8-262k.env — day-0 bf16 profile: glm53:v8-equivalent image entry,
# 262K ctx, bf16 KV, mm front-end ON, MTP k=4, gm 0.85. The original
# September-2026 bring-up profile (89/100); kept only for worst-case
# rollback / memory forensics comparisons.
#
# Rollback usage: stackctl.sh takeover v8-262k

STACK_NAME=v8-262k
IMAGE="${IMAGE:-glm53:v9}"
WEIGHTS_DIR="${WEIGHTS_DIR:?WEIGHTS_DIR must be set in .env}"
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-/var/tmp/glm53-vllm-cache}"
MASTER_PORT="${MASTER_PORT:-29521}"

# --- serving knobs ----------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=                       # bf16 — no KV dtype flag at all
KV_CACHE_MEMORY_BYTES=                # unpinned GMU-sized pool (~311K tok)
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
BLOCK_SIZE=2304
MAX_NUM_BATCHED_TOKENS=
MOE_BACKEND=marlin
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":4}'
SWITCHES='--enforce-eager'
KERNEL_CONFIG=
LIMIT_MM_PER_PROMPT=

VLLM_MLA_NOPE_PAD_ROPE=
TORCH_USE_RTLD_GLOBAL=
VLLM_USE_AOT_COMPILE=
OMP_NUM_THREADS=
FLASHINFER_DISABLE_VERSION_CHECK=1
