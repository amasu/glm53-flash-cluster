# stacks/v9-262k-fp8.env — LibertAIDAI quant, glm53:v9 image, 262K ctx with
# fp8-KV step-1 profile (the 2026-08-28 minimal-risk change: fp8 KV 2x token
# density, gm 0.85, no pin, mm front-end ON, MTP k=4). Historical A/B point
# (90/100) kept as a two-level rollback path.
#
# Rollback usage: cluster.sh v9-262k-fp8 takeover

STACK_NAME=v9-262k-fp8
IMAGE="${IMAGE:-glm53:v9}"
WEIGHTS_DIR="${WEIGHTS_DIR:?WEIGHTS_DIR must be set in .env}"
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-/var/tmp/glm53-vllm-cache}"
MASTER_PORT="${MASTER_PORT:-29521}"

# --- serving knobs ----------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8
KV_CACHE_MEMORY_BYTES=                # unpinned — GMU-sized pool (~610K tok)
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
BLOCK_SIZE=2304
MAX_NUM_BATCHED_TOKENS=               # flag omitted (vLLM default) — as the
                                      # step-1 profile ran
MOE_BACKEND=marlin
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":4}'
# mm front-end stays ON; no chunked prefill/prefix caching/kernel-config —
# exactly the flag set the 262K step-1 profile ran
SWITCHES='--enforce-eager'
KERNEL_CONFIG=
LIMIT_MM_PER_PROMPT=

VLLM_MLA_NOPE_PAD_ROPE=
TORCH_USE_RTLD_GLOBAL=
VLLM_USE_AOT_COMPILE=
OMP_NUM_THREADS=
FLASHINFER_DISABLE_VERSION_CHECK=1
