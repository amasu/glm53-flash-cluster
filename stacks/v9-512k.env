# stacks/v9-512k.env — LibertAIDAI uniform-NVFP4 quant on the glm53:v9 image
# (tonyd2wild v1→v9 patch chain): 512K ctx, fp8 KV, 9 GiB pin, MTP k=4,
# language-model-only. Former default profile (89/100 seed-42 hardmode);
# kept as the primary rollback path for the lab stack.
#
# Rollback usage: cluster.sh v9-512k takeover

STACK_NAME=v9-512k
IMAGE="${IMAGE:-glm53:v9}"
WEIGHTS_DIR="${WEIGHTS_DIR:?WEIGHTS_DIR must be set in .env}"
VLLM_CACHE_DIR="${VLLM_CACHE_DIR:-/var/tmp/glm53-vllm-cache}"
MASTER_PORT="${MASTER_PORT:-29521}"

# --- serving knobs ----------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
KV_CACHE_MEMORY_BYTES=9663676416      # 9 GiB pin -> 1,261,444-token pool
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=6
BLOCK_SIZE=2304                       # 2176 default breaks kpool 64-entry pages
MAX_NUM_BATCHED_TOKENS=4096
MOE_BACKEND=marlin                    # known-good sm_121 fallback
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":4}'
SWITCHES='--enable-chunked-prefill --enable-prefix-caching --disable-custom-all-reduce --enforce-eager --language-model-only'
KERNEL_CONFIG='{"enable_cutedsl_warmup":false,"enable_flashinfer_autotune":false}'
LIMIT_MM_PER_PROMPT=

# v9 image: NoPE-MLA rope-pad is NOT baked in (no VLLM_MLA_NOPE_PAD_ROPE)
VLLM_MLA_NOPE_PAD_ROPE=
TORCH_USE_RTLD_GLOBAL=
VLLM_USE_AOT_COMPILE=
OMP_NUM_THREADS=
FLASHINFER_DISABLE_VERSION_CHECK=1
